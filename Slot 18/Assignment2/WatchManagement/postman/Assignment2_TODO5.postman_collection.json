    {
      "name": "TODO-3.5 Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{accountUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"adminsys\",\n  \"password\": \"@1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const r=pm.response.json();",
              "pm.test(\"Success flag\",()=>pm.expect(r.success).to.eql(true));",
              "pm.collectionVariables.set(\"accessToken\",r.data.accessToken);",
              "pm.collectionVariables.set(\"refreshToken\",r.data.refreshToken);",
              "pm.test(\"Admin role\",()=>pm.expect(r.data.role).to.eql(1));",
              "const decode=t=>JSON.parse(Buffer.from(t.split(\".\")[1],\"base64\").toString());",
              "const a=decode(r.data.accessToken),f=decode(r.data.refreshToken);",
              "pm.test(\"Access claims and 15 minutes\",()=>{pm.expect(a.type).to.eql(\"access\");pm.expect(a.role).to.eql(1);pm.expect(a.sub).to.eql(\"1\");pm.expect(a.exp-a.iat).to.eql(900);});",
              "pm.test(\"Refresh claims and 7 days\",()=>{pm.expect(f.type).to.eql(\"refresh\");pm.expect(f.exp-f.iat).to.eql(604800);});"
            ]
          }
        }
      ]
    },
